# Telegram -> MT5 credentials. Copy to .env and fill in. Never commit .env.

# --- Telegram ---------------------------------------------------------
# From @BotFather. The bot must be an ADMIN of the channel to read posts.
TELEGRAM_BOT_TOKEN=de9b0fa41f24c9d157aa1109e831785b
# Numeric id (e.g. -1001234567890) or @publicchannelname
TELEGRAM_CHANNEL_ID=-1003998687646

# --- MetaTrader 5 -----------------------------------------------------
# native = official MetaTrader5 python package (Windows + running terminal)
# http   = REST bridge you host next to the terminal (use this from Linux)
MT5_MODE=native
MT5_LOGIN=214447
MT5_PASSWORD=Ilovekaitlyn<3
MT5_SERVER=Kudo-Live
# Required only when MT5_MODE=http
MT5_HTTP_URL=http://127.0.0.1:8765

# --- Symbol mapping ---------------------------------------------------
# This broker suffixes its tickers with .s, while the signal channel posts
# undecorated names like XAUUSD. Both settings below are pre-filled for that.
#
# Preferred suffix, used to break ties when several broker tickers match one
# signal symbol (e.g. XAUUSD.s vs XAUUSD.std).
SYMBOL_SUFFIX=.s
# Explicit overrides, checked FIRST - they beat every other matching rule.
# Gold is pinned here so XAUUSD and GOLD always route to XAUUSD.s, rather
# than depending on automatic suffix inference.
# Format: SIGNAL=BROKER, comma separated.
# Add others as needed, e.g. US30=DJ30,NAS100=NDX100
SYMBOL_MAP=XAUUSD=XAUUSD.s,GOLD=XAUUSD.s,XAGUSD=XAGUSD.s,SILVER=XAGUSD.s

# --- Risk / execution -------------------------------------------------
# fixed = always DEFAULT_LOT.  risk = RISK_PERCENT of balance per stop distance.
SIZING_MODE=fixed
# Lot size used in fixed mode.
DEFAULT_LOT=0.01
# Only used when SIZING_MODE=risk.
RISK_PERCENT=1.0
# Used in risk mode when balance/stop/specs are unavailable, or when the
# correct size would fall below the broker's minimum volume.
FALLBACK_LOT=0.01
# Ceiling on volume for a SINGLE signal.
MAX_LOT=1.0
# Ceiling on TOTAL volume across ALL concurrently open positions and pending
# orders. New signals are trimmed to fit, or skipped when there is no room.
MAX_OPEN_LOTS=1.0
# LIVE by default. Set true to log orders without sending them.
DRY_RUN=false
# Leave false so signals without a stop loss are always rejected.
ALLOW_MISSING_SL=false

# --- Rate limiting ----------------------------------------------------
# Long-poll seconds. 20s ~= 4300 requests/day. Minimum 10.
POLL_SECONDS=20
# Hard rolling-24h cap across Telegram + MT5 combined (limit is 10000).
MAX_REQUESTS_24H=9000
