# Copy to .env and fill in locally. The bot loads .env automatically.
# Never commit .env, Telegram session files, or real credentials.

# --- Telegram ---------------------------------------------------------
# user = log in as your own Telegram account (no BotFather/bot admin needed)
# bot  = legacy Bot API mode
TELEGRAM_MODE=user

# User-account mode:
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-me
TELEGRAM_PHONE=+441234567890
# Local Telethon session. Keep this private.
TELEGRAM_SESSION=.telegram_user

# Group/channel your account can already access.
# Public examples: @groupusername
# Private groups can use a numeric peer id if known.
TELEGRAM_CHANNEL_ID=@replace-me

# Bot mode only:
TELEGRAM_BOT_TOKEN=

# --- MetaTrader 5 backend --------------------------------------------
MT5_MODE=native

# Native mode only (also used locally by bridge_server.py on Windows):
MT5_LOGIN=12345678
MT5_PASSWORD=replace-me
MT5_SERVER=Broker-Demo

# HTTP mode client settings:
MT5_HTTP_URL=http://127.0.0.1:8765
BRIDGE_SECRET=replace-with-a-long-random-secret

# bridge_server.py safety:
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_STATE_DB=.bridge_state.sqlite3
ALLOW_NONLOCAL_BRIDGE=false

# --- Symbol mapping ---------------------------------------------------
SYMBOL_SUFFIX=
SYMBOL_MAP=

# --- Sizing / exposure ------------------------------------------------
SIZING_MODE=fixed
DEFAULT_LOT=0.01
RISK_PERCENT=1.0
MAX_LOT=1.0
MAX_OPEN_LOTS=1.0
MAX_OPEN_RISK_PCT=5.0

# --- Execution safety -------------------------------------------------
DRY_RUN=true
ALLOW_LIVE_TRADING=false
ALLOW_REAL_ACCOUNT=false
MAX_SIGNAL_AGE_SECONDS=300
MAX_REFERENCE_DEVIATION_PCT=0.25
MAX_DAILY_EQUITY_LOSS_PCT=3.0
MAX_EQUITY_DRAWDOWN_PCT=5.0
DEVIATION_POINTS=20
MT5_MAGIC=770077
STATE_DB=.trader_state.sqlite3

# --- Polling / request budget -----------------------------------------
POLL_SECONDS=20
MAX_REQUESTS_24H=9000
