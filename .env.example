# Copy to .env and fill in locally. Never commit .env or real credentials.

# --- Telegram ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHANNEL_ID=-1001234567890

# --- MetaTrader 5 backend --------------------------------------------
# native: bot talks directly to a local Windows MT5 terminal.
# http:   bot talks to bridge_server.py; MT5 credentials stay on Windows.
MT5_MODE=native

# Native mode only (also used locally by bridge_server.py on Windows):
MT5_LOGIN=12345678
MT5_PASSWORD=replace-me
MT5_SERVER=Broker-Demo

# HTTP mode client settings:
MT5_HTTP_URL=http://127.0.0.1:8765
BRIDGE_SECRET=replace-with-a-long-random-secret

# bridge_server.py safety (Windows host):
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_STATE_DB=.bridge_state.sqlite3
ALLOW_NONLOCAL_BRIDGE=false

# --- Symbol mapping ---------------------------------------------------
SYMBOL_SUFFIX=
SYMBOL_MAP=

# --- Sizing / exposure ------------------------------------------------
SIZING_MODE=fixed
DEFAULT_LOT=0.01
RISK_PERCENT=1.0
MAX_LOT=1.0
MAX_OPEN_LOTS=1.0
# Maximum combined loss-to-stop across existing + proposed exposure, as % equity.
MAX_OPEN_RISK_PCT=5.0

# --- Execution safety -------------------------------------------------
# Safe default: orders are not sent.
DRY_RUN=true
# Required in addition to DRY_RUN=false.
ALLOW_LIVE_TRADING=false
# Required when the connected MT5 account is real.
ALLOW_REAL_ACCOUNT=false

# Reject Telegram signals older than this many seconds. 0 disables.
MAX_SIGNAL_AGE_SECONDS=300
# For market signals that include an advertised entry, reject if the live
# fill-side price has moved farther than this percentage. 0 disables.
MAX_REFERENCE_DEVIATION_PCT=0.25
# Equity kill switches.
MAX_DAILY_EQUITY_LOSS_PCT=3.0
MAX_EQUITY_DRAWDOWN_PCT=5.0

DEVIATION_POINTS=20
MT5_MAGIC=770077
STATE_DB=.trader_state.sqlite3

# --- Rate limiting ----------------------------------------------------
POLL_SECONDS=20
MAX_REQUESTS_24H=9000
